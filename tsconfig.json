{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@dango/extension-core": [
        "packages/core/src/index.ts"
      ]
    },
    "ignoreDeprecations": "6.0"
  },
  "include": [
    "packages",
    "extensions",
    "scripts"
  ]
}